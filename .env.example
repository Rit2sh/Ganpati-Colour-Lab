# Public site URL (no trailing slash). Used for canonical URLs, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.in

# Google Analytics 4 measurement ID (optional) - enables call/WhatsApp click tracking
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML-tag verification token (the content value only)
NEXT_PUBLIC_GSC_TOKEN=

# Video section: set ONE of these
# 1) Self-hosted MP4 placed in /public/videos
NEXT_PUBLIC_VIDEO_SRC=
# 2) An Instagram reel/post permalink from the studio's own account, e.g. https://www.instagram.com/reel/XXXXXXXX/
NEXT_PUBLIC_REEL_URL=

# Admin area (/admin). If either is empty the admin area is disabled.
ADMIN_USER=
ADMIN_PASSWORD=

# PostgreSQL (only needed when you enable database features)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ganpati?schema=public"
